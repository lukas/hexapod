# Comma-separated role:name:token records. Change these before exposing the service.
HEXAPOD_API_KEYS=admin:local-admin:replace-me,operator:robot-operator:replace-me-too,viewer:observer:replace-me-three
HEXAPOD_DATA_DIR=./lab-data
HEXAPOD_BIND=127.0.0.1
HEXAPOD_PORT=8767
HEXAPOD_DRIVER=simulated

# Optional camera-only AprilTag walk-around. Install hexapod-tracker into the
# same environment, then point the Lab at its four canonical vision files.
# HEXAPOD_TAG_AUDIT_COMMAND=/absolute/path/to/hexapod-audit-layout
# HEXAPOD_TAG_LAYOUT=/absolute/path/to/hexapod-1-apriltag-layout.json
# HEXAPOD_TAG_POSE_TEMPLATE=/absolute/path/to/apriltag_pose_config.json
# HEXAPOD_TAG_FLOOR_MAP=/absolute/path/to/floor_tag_map.json
# HEXAPOD_TAG_PART_MAP=/absolute/path/to/hexapod_tag_map.json
# HEXAPOD_MAX_TAG_PHOTOS=36
# HEXAPOD_MAX_TAG_PHOTO_BYTES=8388608

# Production adapter. Each value is parsed as an argv (no shell interpolation).
# The robot command receives the experiment JSON on stdin and should emit JSONL telemetry on stdout.
# HEXAPOD_ROBOT_COMMAND=/absolute/path/to/robot-runner --mode experiment
# Optional camera source understood by ffmpeg (examples: /dev/video0 or rtsp://...).
# HEXAPOD_CAMERA_INPUT=/dev/video0
