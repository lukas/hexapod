{
    storage file_system /data
}

# Shared lab login for the browser UI. Agent and CLI paths (/mcp, /__buildviz/*)
# and any request carrying an API credential keep the hub's own API-key gate.
buildviz.cwd1f0-new-cluster.coreweave.app {
    @browser {
        not header Authorization *
        not header X-API-Key *
        not path /mcp /__buildviz/*
    }
    basic_auth @browser {
        lukas {env.LAB_LOGIN_HASH}  # bcrypt hash injected at deploy; source of truth ~/.hexapod/web-login.hash
    }
    request_header X-Hexapod-User {http.auth.user.id}
    reverse_proxy 127.0.0.1:5183
}
