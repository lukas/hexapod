{
    storage file_system /data
}

# Single sign-on shared with hexapod.cwd1f0-new-cluster.coreweave.app. Agent
# and CLI paths (/mcp, /__buildviz/*) and any request carrying an API
# credential keep the hub's own API-key gate.
buildviz.cwd1f0-new-cluster.coreweave.app {
    @browser {
        not header Authorization *
        not header X-API-Key *
        not path /mcp /__buildviz/*
    }
    forward_auth @browser https://hexapod.cwd1f0-new-cluster.coreweave.app {
        uri /auth
        copy_headers X-Hexapod-User
        header_up X-Hexapod-Original {http.request.scheme}://{http.request.host}{http.request.uri}
        header_up Host hexapod.cwd1f0-new-cluster.coreweave.app
    }
    reverse_proxy 127.0.0.1:5183
}
